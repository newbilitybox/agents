{
  "name": "agents",
  "version": "0.2.34",
  "description": "GUI for managing multiple Claude Code CLI accounts and sessions",
  "author": "Lucas",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test 'src/**/*.test.ts'",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "install-electron && electron-rebuild -f -w node-pty",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac",
    "release": "[ -f .env ] && . ./.env; node scripts/release.mjs"
  },
  "license": "ISC",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "dependencies": {
    "electron-store": "^11.0.2",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "43.1.0",
    "electron-builder": "26.15.6",
    "electron-vite": "^5.0.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "playwright-core": "^1.61.1",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "zustand": "^5.0.14"
